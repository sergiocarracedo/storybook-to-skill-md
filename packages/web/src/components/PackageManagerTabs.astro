---
interface Props {
  npm?: string
  pnpm?: string
  yarn?: string
  bun?: string
  class?: string
}

const { npm = '', pnpm = '', yarn = '', bun = '', class: className = '' } = Astro.props
const id = `tabs-${Math.random().toString(36).substring(2, 11)}`
const commands = { npm, pnpm, yarn, bun }

const tabs = [
  {
    key: 'npm',
    label: 'npm',
    icon: `<svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-[#CB3837]" fill="currentColor"><path d="M1.763 0C.786 0 0 .786 0 1.763v20.474C0 23.214.786 24 1.763 24h20.474c.977 0 1.763-.786 1.763-1.763V1.763C24 .786 23.214 0 22.237 0zM5.13 5.323l13.837.019-.009 13.836h-3.464l.01-10.382h-3.456L12.04 19.17H5.113z"/></svg>`,
  },
  {
    key: 'pnpm',
    label: 'pnpm',
    icon: `<svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-[#F69220]" fill="currentColor"><path d="M0 0h7.5v7.5H0zm8.25 0h7.5v7.5h-7.5zm8.25 0H24v7.5h-7.5zM0 8.25h7.5v7.5H0zm8.25 0h7.5v7.5h-7.5zm8.25 0H24v7.5h-7.5zM0 16.5h7.5V24H0zm8.25 0h7.5V24h-7.5z"/></svg>`,
  },
  {
    key: 'yarn',
    label: 'yarn',
    icon: `<svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-[#2C8EBB]" fill="currentColor"><path d="M22.49 5.38l-10.49 18.62-10.49-18.62h5.24l5.25 9.31 5.25-9.31z"/></svg>`,
  },
  {
    key: 'bun',
    label: 'bun',
    icon: `<svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-[#FBF0DF]" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 22c-5.523 0-10-4.477-10-10S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10zm-3.5-8.5c-.828 0-1.5-.672-1.5-1.5s.672-1.5 1.5-1.5 1.5.672 1.5 1.5-.672 1.5-1.5 1.5zm7 0c-.828 0-1.5-.672-1.5-1.5s.672-1.5 1.5-1.5 1.5.672 1.5 1.5-.672 1.5-1.5 1.5zm-3.5 4.5c-1.933 0-3.5-1.567-3.5-3.5h7c0 1.933-1.567 3.5-3.5 3.5z"/></svg>`,
  },
]
---

<div
  class={`rounded-lg overflow-hidden bg-[#1e1e20] border border-gray-800 max-w-full ${className}`}
  data-tabs-container={id}
>
  <!-- Tab bar -->
  <div class="flex bg-[#252529] px-1 border-b border-gray-800 overflow-x-auto hide-scrollbar">
    {tabs.map(({ key, label, icon }, index) => (
      <button
        class="pm-tab relative flex items-center gap-1.5 px-3 py-2 text-sm font-medium transition-colors whitespace-nowrap"
        data-tab={key}
        data-tabs-id={id}
        data-active={index === 0 ? 'true' : 'false'}
      >
        <Fragment set:html={icon} />
        {label}
      </button>
    ))}
  </div>

  <!-- Content panels -->
  {tabs.map(({ key }, index) => (
    <div
      data-tab-content={key}
      data-tabs-id={id}
      class={`relative group ${index !== 0 ? 'hidden' : ''}`}
    >
      <pre
        class="text-gray-300 text-sm font-mono m-0 px-4 py-3 overflow-x-auto hide-scrollbar pr-10"
        id={`${id}-${key}`}
      ><code><span class="text-gray-500 select-none">$ </span>{commands[key as keyof typeof commands]}</code></pre>
      <button
        class="absolute top-2 right-2 p-1.5 rounded bg-gray-700 hover:bg-gray-600 text-white opacity-0 group-hover:opacity-100 transition-opacity"
        data-copy-target={`${id}-${key}`}
        title="Copy to clipboard"
      >
        <svg class="w-3.5 h-3.5 copy-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
        </svg>
        <svg class="w-3.5 h-3.5 check-icon hidden text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
      </button>
    </div>
  ))}
</div>

<style>
  .pm-tab[data-active="true"] {
    color: rgb(229 231 235); /* gray-200 */
  }
  .pm-tab[data-active="false"] {
    color: rgb(107 114 128); /* gray-500 */
  }
  .pm-tab[data-active="false"]:hover {
    color: rgb(209 213 219); /* gray-300 */
  }
  /* Gradient underline indicator for active tab */
  .pm-tab[data-active="true"]::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(to right, #9333ea, #06b6d4);
  }
  .hide-scrollbar::-webkit-scrollbar { display: none; }
  .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
  // Tab switching
  document.addEventListener('click', (e) => {
    const button = (e.target as Element).closest('[data-tab][data-tabs-id]')
    if (!button || (e.target as Element).closest('[data-copy-target]')) return

    const tabName = button.getAttribute('data-tab')
    const tabsId = button.getAttribute('data-tabs-id')
    if (!tabName || !tabsId) return

    const container = document.querySelector(`[data-tabs-container="${tabsId}"]`)
    if (!container) return

    container.querySelectorAll(`[data-tab][data-tabs-id="${tabsId}"]`).forEach((btn) => {
      btn.setAttribute('data-active', btn === button ? 'true' : 'false')
    })

    container.querySelectorAll(`[data-tab-content][data-tabs-id="${tabsId}"]`).forEach((content) => {
      content.classList.toggle('hidden', content.getAttribute('data-tab-content') !== tabName)
    })
  })

  // Copy functionality
  document.addEventListener('click', async (e) => {
    const button = (e.target as Element).closest('[data-copy-target]')
    if (!button) return

    const targetId = button.getAttribute('data-copy-target')
    const codeElement = document.getElementById(targetId!)
    if (!codeElement) return

    let code = codeElement.textContent || ''
    if (code.startsWith('$')) code = code.substring(1).trim()

    try {
      await navigator.clipboard.writeText(code)
      const copyIcon = button.querySelector('.copy-icon')
      const checkIcon = button.querySelector('.check-icon')
      copyIcon?.classList.add('hidden')
      checkIcon?.classList.remove('hidden')
      setTimeout(() => {
        copyIcon?.classList.remove('hidden')
        checkIcon?.classList.add('hidden')
      }, 2000)
    } catch (err) {
      console.error('Failed to copy:', err)
    }
  })
</script>
