---
import { ViewTransitions } from 'astro:transitions'
import CodeBlock from '../components/CodeBlock.astro'
import PackageManagerTabs from '../components/PackageManagerTabs.astro'
import HeroShader from '../components/HeroShader.astro'
import ActionShader from '../components/ActionShader.astro'
import '../styles/custom.css'

const packageName = 'storybook-to-skills-md'
const basePath = import.meta.env.BASE_URL
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Storybook to SKILL.md - Generate AI-ready component docs</title>
    <meta
      name="description"
      content="CLI tool that reads Storybook projects and generates SKILL.md files for AI agents using LLMs"
    />
    <ViewTransitions />
  </head>
  <body class="bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100">
    <!-- Shared SVG gradient for icons (position:absolute avoids display:none breaking cross-SVG url() refs) -->
    <svg style="position:absolute;width:0;height:0;overflow:hidden;" aria-hidden="true">
      <defs>
        <linearGradient id="feat-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#9333ea"/>
          <stop offset="100%" stop-color="#06b6d4"/>
        </linearGradient>
      </defs>
    </svg>
    <!-- Header -->
    <header class="border-b border-gray-200 dark:border-gray-800">
      <nav
        class="container mx-auto px-4 py-4 flex justify-between items-center"
      >
        <div class="flex items-center gap-2">
          <img src={`${basePath}/logo.svg`} alt="Logo" class="w-8 h-8" />
          <span class="font-bold text-xl">Storybook to SKILL.md</span>
        </div>
        <div class="flex items-center gap-6">
          <a
            href={`${basePath}/getting-started/installation`}
            class="hover:text-primary-600 transition-colors">Docs</a
          >
          <a
            href="https://github.com/sergiocarracedo/storybook-to-skill-md"
            class="hover:text-primary-600 transition-colors">GitHub</a
          >
        </div>
      </nav>
    </header>

    <!-- Hero Section -->
    <section class="relative py-20 overflow-hidden" style="background:#1a0535">
      <HeroShader />
      <div class="relative z-10 container mx-auto px-4 text-center">
        <div class="mb-4 flex justify-center gap-3">
          <a
            href="https://github.com/sergiocarracedo/storybook-to-skill-md"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-3 py-1 bg-white/10 text-white/90 rounded-full text-sm font-medium hover:bg-white/20 transition-colors border border-white/20"
          >
            Open Source
          </a>
          <a
            href="https://www.npmjs.com/package/storybook-to-skills-md"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-3 py-1 bg-white/10 text-white/90 rounded-full text-sm font-medium hover:bg-white/20 transition-colors border border-white/20"
          >
            npm
          </a>
          <a
            href="https://github.com/sergiocarracedo/storybook-to-skill-md-action"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-3 py-1 bg-white/10 text-white/90 rounded-full text-sm font-medium hover:bg-white/20 transition-colors border border-white/20"
          >
            GitHub Action
          </a>
        </div>

        <h1 class="text-5xl md:text-6xl font-bold mb-6 animate-fade-in-up text-white [text-shadow:0_2px_24px_rgba(0,0,0,0.6)]">
          Generate AI-ready component docs<br />
          <span
            class="bg-gradient-to-r from-primary-300 to-secondary-300 bg-clip-text text-transparent"
            >from Storybook</span
          >
        </h1>

        <p
          class="text-xl text-white/70 mb-8 max-w-2xl mx-auto [text-shadow:0_1px_12px_rgba(0,0,0,0.5)]"
        >
          Automatically create SKILL.md files from your Storybook components
          using AI. Make your design system truly AI-friendly.
        </p>

        <div class="flex justify-center gap-4 mb-12">
          <a
            href={`${basePath}/getting-started/installation`}
            class="px-6 py-3 bg-white text-primary-900 hover:bg-white/90 rounded-lg font-medium transition-colors"
          >
            Get Started
          </a>
          <a
            href="https://github.com/sergiocarracedo/storybook-to-skill-md"
            class="px-6 py-3 bg-black/60 backdrop-blur-sm border border-white/20 text-white hover:bg-black/75 rounded-lg font-medium transition-colors"
          >
            View on GitHub
          </a>
        </div>

        <!-- Terminal Demo -->
        <div
          class="max-w-3xl mx-auto rounded-xl overflow-hidden shadow-2xl shadow-black/40"
        >
          <!-- Window chrome -->
          <div class="flex items-center gap-2 px-4 py-3 bg-[#2a2a2c]">
            <span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
            <span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
            <span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
            <span class="ml-2 text-xs text-gray-500 font-mono">storybook-to-skills-md</span>
          </div>
          <div class="bg-[#1a1a1c] text-gray-100 p-6 font-mono text-sm text-left"
        >
          <div class="mb-2">
            <span class="text-green-400">$</span> pnpm add -g {packageName}
          </div>
          <div class="mb-2 text-gray-300">✓ Package installed successfully</div>
          <div class="mb-2">
            <span class="text-green-400">$</span> storybook-to-skills-md generate
            \
          </div>
          <div class="mb-2">
            &nbsp;&nbsp;--storybook-url https://your-storybook.com \
          </div>
          <div class="mb-2">&nbsp;&nbsp;--provider openai \</div>
          <div class="mb-2">&nbsp;&nbsp;--model gpt-5.2</div>
          <div class="mb-2 text-gray-300 mt-2">
            ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
          </div>
          <div class="mb-2 text-gray-300">[COMPONENT] Button</div>
          <div class="mb-2 text-gray-300">
            [EXTRACT] Fetching sources... OK (1.2s)
          </div>
          <div class="mb-2 text-gray-300">
            [GENERATE] Creating skill files... OK (8.5s, ~4,200 tokens)
          </div>
          <div class="mb-2 text-green-400">
            [OK] Completed (10.5s, ~4,200 tokens)
          </div>
        </div>
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="py-20">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">
          How it works
        </h2>
        <p class="text-center text-gray-600 dark:text-gray-400 mb-12">
          Three steps. Minimal configuration.
        </p>

        <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          <!-- Step 1 -->
          <div class="text-center">
            <div
              class="w-12 h-12 bg-primary-100 dark:bg-primary-900/30 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <span
                class="text-2xl font-bold text-primary-600 dark:text-primary-400"
                >1</span
              >
            </div>
            <h3 class="text-xl font-bold mb-2">Install</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              Install the CLI globally using your favorite package manager.
            </p>
            <PackageManagerTabs command={`{pm} install -g ${packageName}`} />
          </div>

          <!-- Step 2 -->
          <div class="text-center">
            <div
              class="w-12 h-12 bg-primary-100 dark:bg-primary-900/30 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <span
                class="text-2xl font-bold text-primary-600 dark:text-primary-400"
                >2</span
              >
            </div>
            <h3 class="text-xl font-bold mb-2">Run</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              Point it to your Storybook and choose your LLM provider.
            </p>
            <CodeBlock
              code={`storybook-to-skills-md generate \\
  --storybook-url https://... \\
  --provider openai`}
              theme="light"
            />
          </div>

          <!-- Step 3 -->
          <div class="text-center">
            <div
              class="w-12 h-12 bg-primary-100 dark:bg-primary-900/30 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <span
                class="text-2xl font-bold text-primary-600 dark:text-primary-400"
                >3</span
              >
            </div>
            <h3 class="text-xl font-bold mb-2">Use with AI</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              SKILL.md files are ready to be consumed by AI agents.
            </p>
            <CodeBlock
              code={`skills/
├── button/SKILL.md
├── input/SKILL.md
└── ...`}
              theme="light"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Features Grid -->
    <section class="py-20 bg-gradient-to-br from-primary-50 to-secondary-50 dark:from-primary-950/30 dark:to-secondary-950/30">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
          Built for modern workflows
        </h2>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
          <div
            class="p-6 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 hover:border-primary-500 dark:hover:border-primary-500 transition-colors shadow-sm"
          >
            <svg class="w-8 h-8 mb-3" viewBox="0 0 24 24" fill="none" stroke="url(#feat-gradient)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="11" width="18" height="10" rx="2"/>
              <circle cx="12" cy="5" r="2"/>
              <path d="M12 7v4M8 15h.01M16 15h.01"/>
            </svg>
            <h3 class="text-lg font-bold mb-2">Multiple LLM Providers</h3>
            <p class="text-gray-600 dark:text-gray-400">
              Works with OpenAI, Anthropic Claude, and Google Gemini. Choose
              your preferred provider.
            </p>
          </div>

          <div
            class="p-6 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 hover:border-primary-500 dark:hover:border-primary-500 transition-colors shadow-sm"
          >
            <svg class="w-8 h-8 mb-3" viewBox="0 0 24 24" fill="none" stroke="url(#feat-gradient)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="2" y1="2" x2="22" y2="22"/>
              <path d="M8.5 16.5a5 5 0 017 0M2 8.82a15 15 0 0112.33-3.72M5.46 12.12a10 10 0 015.54-2.62"/>
              <circle cx="12" cy="20" r=".5" fill="url(#feat-gradient)"/>
            </svg>
            <h3 class="text-lg font-bold mb-2">Offline Mode</h3>
            <p class="text-gray-600 dark:text-gray-400">
              Use local index.json from built Storybook. No server needed.
            </p>
          </div>

          <div
            class="p-6 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 hover:border-primary-500 dark:hover:border-primary-500 transition-colors shadow-sm"
          >
            <svg class="w-8 h-8 mb-3" viewBox="0 0 24 24" fill="none" stroke="url(#feat-gradient)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" fill="url(#feat-gradient)" fill-opacity="0.15"/>
            </svg>
            <h3 class="text-lg font-bold mb-2">Incremental Generation</h3>
            <p class="text-gray-600 dark:text-gray-400">
              Smart caching skips unchanged components. Only regenerate what
              changed.
            </p>
          </div>

          <a
            href="https://github.com/sergiocarracedo/storybook-to-skill-md-action"
            target="_blank"
            rel="noopener noreferrer"
            class="p-6 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 hover:border-primary-500 dark:hover:border-primary-500 transition-colors shadow-sm block"
          >
            <svg class="w-8 h-8 mb-3" viewBox="0 0 24 24" fill="none" stroke="url(#feat-gradient)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <circle cx="12" cy="12" r="6"/>
              <circle cx="12" cy="12" r="2" fill="url(#feat-gradient)"/>
            </svg>
            <h3 class="text-lg font-bold mb-2">GitHub Action</h3>
            <p class="text-gray-600 dark:text-gray-400">
              Automate SKILL.md generation in CI/CD with our official GitHub
              Action.
            </p>
          </a>

          <div
            class="p-6 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 hover:border-primary-500 dark:hover:border-primary-500 transition-colors shadow-sm"
          >
            <svg class="w-8 h-8 mb-3" viewBox="0 0 24 24" fill="none" stroke="url(#feat-gradient)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3"/>
              <path d="M1 14h6M9 8h6M17 16h6"/>
            </svg>
            <h3 class="text-lg font-bold mb-2">Customizable Prompts</h3>
            <p class="text-gray-600 dark:text-gray-400">
              Bring your own system prompt to customize generated documentation
              style.
            </p>
          </div>

          <div
            class="p-6 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 hover:border-primary-500 dark:hover:border-primary-500 transition-colors shadow-sm"
          >
            <svg class="w-8 h-8 mb-3" viewBox="0 0 24 24" fill="none" stroke="url(#feat-gradient)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="16 18 22 12 16 6"/>
              <polyline points="8 6 2 12 8 18"/>
            </svg>
            <h3 class="text-lg font-bold mb-2">TypeScript Native</h3>
            <p class="text-gray-600 dark:text-gray-400">
              Built with TypeScript. Full type safety and great DX.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- GitHub Action Section -->
    <section class="py-20 relative overflow-hidden" style="background:#150022">
      <ActionShader />
      <div class="relative z-10 container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-bold mb-6 text-white [text-shadow:0_2px_24px_rgba(0,0,0,0.6)]">
            CI/CD with GitHub Action
          </h2>
          <p class="text-xl text-white/70 mb-8 [text-shadow:0_1px_12px_rgba(0,0,0,0.5)]">
            Automate SKILL.md generation in your GitHub Actions workflow.
            Run it on every push, PR, or release.
          </p>

          <div class="bg-black/40 backdrop-blur-sm text-gray-100 p-6 rounded-lg text-left font-mono text-sm overflow-x-auto mb-8 border border-white/10">
            <CodeBlock
              code={`- name: Generate SKILL.md
  uses: sergiocarracedo/storybook-to-skill-md-action@v1
  with:
    storybook-url: 'https://your-storybook.com'
    source-dir: './src/components'
    output-dir: './skills'
    provider: 'openai'
    model: 'gpt-4o'
    api-key: \${{ secrets.OPENAI_API_KEY }}`}
              theme="dark"
            />
          </div>

          <div class="flex justify-center gap-4">
            <a
              href="https://github.com/sergiocarracedo/storybook-to-skill-md-action"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 text-white rounded-lg font-medium transition-all inline-flex items-center gap-2 hover:opacity-90"
              style="background: linear-gradient(135deg, #9333ea, #06b6d4)"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              View on GitHub
            </a>
            <a
              href={`${basePath}/getting-started/github-action`}
              class="px-6 py-3 bg-black/60 backdrop-blur-sm border border-white/20 text-white hover:bg-black/75 rounded-lg font-medium transition-colors"
            >
              View Docs →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Installation -->
    <section class="py-20">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
          Installation
        </h2>

        <div class="max-w-3xl mx-auto">
          <PackageManagerTabs command={`{pm} install -g ${packageName}`} />

          <div class="mt-8 text-center">
            <a
              href={`${basePath}/getting-started/quick-start`}
              class="text-primary-600 hover:text-primary-700 font-medium"
            >
              Read the quick start guide →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-gray-200 dark:border-gray-800 py-12">
      <div class="container mx-auto px-4">
        <div class="grid md:grid-cols-3 gap-8">
          <div>
            <h4 class="font-bold mb-4">Product</h4>
            <ul class="space-y-2">
              <li>
                <a
                  href={`${basePath}/getting-started/installation`}
                  class="text-gray-600 dark:text-gray-400 hover:text-primary-600"
                  >Documentation</a
                >
              </li>
              <li>
                <a
                  href={`${basePath}/getting-started/github-action`}
                  class="text-gray-600 dark:text-gray-400 hover:text-primary-600"
                  >GitHub Action</a
                >
              </li>
              <li>
                <a
                  href={`${basePath}/getting-started/quick-start`}
                  class="text-gray-600 dark:text-gray-400 hover:text-primary-600"
                  >Quick Start</a
                >
              </li>
            </ul>
          </div>

          <div>
            <h4 class="font-bold mb-4">Resources</h4>
            <ul class="space-y-2">
              <li>
                <a
                  href={`${basePath}/cli/commands`}
                  class="text-gray-600 dark:text-gray-400 hover:text-primary-600"
                  >CLI Commands</a
                >
              </li>
              <li>
                <a
                  href={`${basePath}/providers/overview`}
                  class="text-gray-600 dark:text-gray-400 hover:text-primary-600"
                  >LLM Providers</a
                >
              </li>
              <li>
                <a
                  href={`${basePath}/reference/troubleshooting`}
                  class="text-gray-600 dark:text-gray-400 hover:text-primary-600"
                  >Troubleshooting</a
                >
              </li>
            </ul>
          </div>

          <div>
            <h4 class="font-bold mb-4">Community</h4>
            <ul class="space-y-2">
              <li>
                <a
                  href="https://github.com/sergiocarracedo/storybook-to-skill-md"
                  class="text-gray-600 dark:text-gray-400 hover:text-primary-600"
                  >GitHub</a
                >
              </li>
              <li>
                <a
                  href="https://github.com/sergiocarracedo/storybook-to-skill-md/issues"
                  class="text-gray-600 dark:text-gray-400 hover:text-primary-600"
                  >Issues</a
                >
              </li>
            </ul>
          </div>
        </div>

        <div
          class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-800 text-center text-gray-600 dark:text-gray-400"
        >
          <p>
            MIT License. Built by <a
              href="https://github.com/sergiocarracedo"
              class="hover:text-primary-600">Sergio Carracedo</a
            >
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
