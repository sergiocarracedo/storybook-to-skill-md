---
import { ViewTransitions } from 'astro:transitions';
import '../styles/custom.css';

const packageName = '@sergiocarracedo/storybook-to-skills-md';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Storybook to SKILL.md - Generate AI-ready component docs</title>
  <meta name="description" content="CLI tool that reads Storybook projects and generates SKILL.md files for AI agents using LLMs">
  <ViewTransitions />
</head>
<body class="bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100">
  <!-- Header -->
  <header class="border-b border-gray-200 dark:border-gray-800">
    <nav class="container mx-auto px-4 py-4 flex justify-between items-center">
      <div class="flex items-center gap-2">
        <img src="/logo.svg" alt="Logo" class="w-8 h-8">
        <span class="font-bold text-xl">Storybook to SKILL.md</span>
      </div>
      <div class="flex items-center gap-6">
        <a href="/getting-started/installation" class="hover:text-purple-600 transition-colors">Docs</a>
        <a href="https://github.com/sergiocarracedo/storybook-to-skill-md" class="hover:text-purple-600 transition-colors">GitHub</a>
      </div>
    </nav>
  </header>

  <!-- Hero Section -->
  <section class="hero-gradient py-20">
    <div class="container mx-auto px-4 text-center">
      <div class="mb-4">
        <span class="inline-block px-3 py-1 bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full text-sm font-medium">
          Open Source
        </span>
      </div>
      
      <h1 class="text-5xl md:text-6xl font-bold mb-6 animate-fade-in-up">
        Generate AI-ready component docs<br />
        <span class="bg-gradient-to-r from-purple-600 to-cyan-500 bg-clip-text text-transparent">from Storybook</span>
      </h1>
      
      <p class="text-xl text-gray-600 dark:text-gray-400 mb-8 max-w-2xl mx-auto">
        Automatically create SKILL.md files from your Storybook components using OpenAI, Anthropic, or Google AI.
        Make your design system truly AI-friendly.
      </p>

      <div class="flex justify-center gap-4 mb-12">
        <a href="/getting-started/installation" class="px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium transition-colors">
          Get Started
        </a>
        <a href="https://github.com/sergiocarracedo/storybook-to-skill-md" class="px-6 py-3 border border-gray-300 dark:border-gray-700 hover:border-purple-600 dark:hover:border-purple-600 rounded-lg font-medium transition-colors">
          View on GitHub
        </a>
      </div>

      <!-- Terminal Demo -->
      <div class="max-w-3xl mx-auto bg-gray-900 text-gray-100 p-6 rounded-lg font-mono text-sm">
        <div class="mb-2">
          <span class="text-green-400">$</span> pnpm add -g {packageName}
        </div>
        <div class="mb-2 text-gray-300">
          ✓ Package installed successfully
        </div>
        <div class="mb-2">
          <span class="text-green-400">$</span> storybook-to-skills-md generate \
        </div>
        <div class="mb-2">
          &nbsp;&nbsp;--storybook-url https://your-storybook.com \
        </div>
        <div class="mb-2">
          &nbsp;&nbsp;--provider openai \
        </div>
        <div class="mb-2">
          &nbsp;&nbsp;--model gpt-4o
        </div>
        <div class="mb-2 text-gray-300 mt-2">
          ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        </div>
        <div class="mb-2 text-gray-300">
          [COMPONENT] Button
        </div>
        <div class="mb-2 text-gray-300">
          [EXTRACT] Fetching sources... OK (1.2s)
        </div>
        <div class="mb-2 text-gray-300">
          [GENERATE] Creating skill files... OK (8.5s, ~4,200 tokens)
        </div>
        <div class="mb-2 text-green-400">
          [OK] Completed (10.5s, ~4,200 tokens)
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-20">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">How it works</h2>
      <p class="text-center text-gray-600 dark:text-gray-400 mb-12">Three steps. Minimal configuration.</p>

      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <!-- Step 1 -->
        <div class="text-center">
          <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl font-bold text-purple-600 dark:text-purple-400">1</span>
          </div>
          <h3 class="text-xl font-bold mb-2">Install</h3>
          <p class="text-gray-600 dark:text-gray-400 mb-4">
            Install the CLI globally using your favorite package manager.
          </p>
          <pre class="bg-gray-100 dark:bg-gray-900 p-3 rounded text-sm text-left"><code>npm install -g {packageName}</code></pre>
        </div>

        <!-- Step 2 -->
        <div class="text-center">
          <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl font-bold text-purple-600 dark:text-purple-400">2</span>
          </div>
          <h3 class="text-xl font-bold mb-2">Run</h3>
          <p class="text-gray-600 dark:text-gray-400 mb-4">
            Point it to your Storybook and choose your LLM provider.
          </p>
          <pre class="bg-gray-100 dark:bg-gray-900 p-3 rounded text-sm text-left"><code>storybook-to-skills-md generate \\
  --storybook-url https://... \\
  --provider openai</code></pre>
        </div>

        <!-- Step 3 -->
        <div class="text-center">
          <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl font-bold text-purple-600 dark:text-purple-400">3</span>
          </div>
          <h3 class="text-xl font-bold mb-2">Use with AI</h3>
          <p class="text-gray-600 dark:text-gray-400 mb-4">
            SKILL.md files are ready to be consumed by AI agents.
          </p>
          <pre class="bg-gray-100 dark:bg-gray-900 p-3 rounded text-sm text-left"><code>skills/
├── button/SKILL.md
├── input/SKILL.md
└── ...</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Grid -->
  <section class="py-20 bg-gray-50 dark:bg-gray-900/50">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">Built for modern workflows</h2>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        <div class="p-6 rounded-lg border border-gray-200 dark:border-gray-800 hover:border-purple-500 dark:hover:border-purple-500 transition-colors">
          <div class="text-3xl mb-3">🤖</div>
          <h3 class="text-lg font-bold mb-2">Multiple LLM Providers</h3>
          <p class="text-gray-600 dark:text-gray-400">
            Works with OpenAI, Anthropic Claude, and Google Gemini. Choose your preferred provider.
          </p>
        </div>

        <div class="p-6 rounded-lg border border-gray-200 dark:border-gray-800 hover:border-purple-500 dark:hover:border-purple-500 transition-colors">
          <div class="text-3xl mb-3">📴</div>
          <h3 class="text-lg font-bold mb-2">Offline Mode</h3>
          <p class="text-gray-600 dark:text-gray-400">
            Use local index.json from built Storybook. No server needed.
          </p>
        </div>

        <div class="p-6 rounded-lg border border-gray-200 dark:border-gray-800 hover:border-purple-500 dark:hover:border-purple-500 transition-colors">
          <div class="text-3xl mb-3">⚡</div>
          <h3 class="text-lg font-bold mb-2">Incremental Generation</h3>
          <p class="text-gray-600 dark:text-gray-400">
            Smart caching skips unchanged components. Only regenerate what changed.
          </p>
        </div>

        <div class="p-6 rounded-lg border border-gray-200 dark:border-gray-800 hover:border-purple-500 dark:hover:border-purple-500 transition-colors">
          <div class="text-3xl mb-3">🎯</div>
          <h3 class="text-lg font-bold mb-2">GitHub Action</h3>
          <p class="text-gray-600 dark:text-gray-400">
            Automate SKILL.md generation in CI/CD with our official GitHub Action.
          </p>
        </div>

        <div class="p-6 rounded-lg border border-gray-200 dark:border-gray-800 hover:border-purple-500 dark:hover:border-purple-500 transition-colors">
          <div class="text-3xl mb-3">🎨</div>
          <h3 class="text-lg font-bold mb-2">Customizable Prompts</h3>
          <p class="text-gray-600 dark:text-gray-400">
            Bring your own system prompt to customize generated documentation style.
          </p>
        </div>

        <div class="p-6 rounded-lg border border-gray-200 dark:border-gray-800 hover:border-purple-500 dark:hover:border-purple-500 transition-colors">
          <div class="text-3xl mb-3">📘</div>
          <h3 class="text-lg font-bold mb-2">TypeScript Native</h3>
          <p class="text-gray-600 dark:text-gray-400">
            Built with TypeScript. Full type safety and great DX.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Installation -->
  <section class="py-20">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">Installation</h2>

      <div class="max-w-3xl mx-auto">
        <div class="flex gap-2 mb-4">
          <button class="px-4 py-2 font-medium rounded-t-lg transition-colors bg-purple-600 text-white" data-tab="npm">npm</button>
          <button class="px-4 py-2 font-medium rounded-t-lg transition-colors bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700" data-tab="pnpm">pnpm</button>
          <button class="px-4 py-2 font-medium rounded-t-lg transition-colors bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700" data-tab="yarn">yarn</button>
        </div>

        <div id="npm-tab" class="tab-content">
          <pre class="bg-gray-900 text-gray-100 p-6 rounded-lg"><code>npm install -g {packageName}</code></pre>
        </div>

        <div id="pnpm-tab" class="tab-content hidden">
          <pre class="bg-gray-900 text-gray-100 p-6 rounded-lg"><code>pnpm add -g {packageName}</code></pre>
        </div>

        <div id="yarn-tab" class="tab-content hidden">
          <pre class="bg-gray-900 text-gray-100 p-6 rounded-lg"><code>yarn global add {packageName}</code></pre>
        </div>

        <div class="mt-8 text-center">
          <a href="/getting-started/quick-start" class="text-purple-600 hover:text-purple-700 font-medium">
            Read the quick start guide →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-gray-200 dark:border-gray-800 py-12">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-3 gap-8">
        <div>
          <h4 class="font-bold mb-4">Product</h4>
          <ul class="space-y-2">
            <li><a href="/getting-started/installation" class="text-gray-600 dark:text-gray-400 hover:text-purple-600">Documentation</a></li>
            <li><a href="/guides/github-action" class="text-gray-600 dark:text-gray-400 hover:text-purple-600">GitHub Action</a></li>
            <li><a href="/reference/use-cases" class="text-gray-600 dark:text-gray-400 hover:text-purple-600">Use Cases</a></li>
          </ul>
        </div>

        <div>
          <h4 class="font-bold mb-4">Resources</h4>
          <ul class="space-y-2">
            <li><a href="/cli/commands" class="text-gray-600 dark:text-gray-400 hover:text-purple-600">CLI Commands</a></li>
            <li><a href="/providers/openai" class="text-gray-600 dark:text-gray-400 hover:text-purple-600">LLM Providers</a></li>
            <li><a href="/reference/troubleshooting" class="text-gray-600 dark:text-gray-400 hover:text-purple-600">Troubleshooting</a></li>
          </ul>
        </div>

        <div>
          <h4 class="font-bold mb-4">Community</h4>
          <ul class="space-y-2">
            <li><a href="https://github.com/sergiocarracedo/storybook-to-skill-md" class="text-gray-600 dark:text-gray-400 hover:text-purple-600">GitHub</a></li>
            <li><a href="https://github.com/sergiocarracedo/storybook-to-skill-md/issues" class="text-gray-600 dark:text-gray-400 hover:text-purple-600">Issues</a></li>
          </ul>
        </div>
      </div>

      <div class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-800 text-center text-gray-600 dark:text-gray-400">
        <p>MIT License. Built by <a href="https://github.com/sergiocarracedo" class="hover:text-purple-600">Sergio Carracedo</a></p>
      </div>
    </div>
  </footer>

  <script>
    // Tab switching
    const tabButtons = document.querySelectorAll('[data-tab]');
    const tabContents = document.querySelectorAll('.tab-content');

    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        const tabName = button.getAttribute('data-tab');
        
        // Update button states
        tabButtons.forEach(btn => {
          if (btn === button) {
            btn.className = 'px-4 py-2 font-medium rounded-t-lg transition-colors bg-purple-600 text-white';
          } else {
            btn.className = 'px-4 py-2 font-medium rounded-t-lg transition-colors bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700';
          }
        });
        
        // Update content visibility
        tabContents.forEach(content => {
          if (content.id === `${tabName}-tab`) {
            content.classList.remove('hidden');
          } else {
            content.classList.add('hidden');
          }
        });
      });
    });
  </script>
</body>
</html>
