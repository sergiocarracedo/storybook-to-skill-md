{
  "name": "storybook-to-skill-md-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for storybook-to-skill-md CLI and landing page",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @sergiocarracedo/storybook-to-skills-md test",
    "test:run": "pnpm --filter @sergiocarracedo/storybook-to-skills-md test:run",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf node_modules dist .astro"
  },
  "keywords": [],
  "author": "Sergio Carracedo <hi@sergiocarracedo.es>",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
