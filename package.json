{
  "name": "storybook-to-skill-md",
  "version": "0.1.0",
  "description": "CLI tool that reads Storybook projects and generates SKILL.md files for AI agents using LLMs",
  "type": "module",
  "bin": {
    "storybook-to-skill-md": "./bin/cli.ts"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx bin/cli.ts",
    "start": "tsx bin/cli.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "pnpm run typecheck"
  },
  "keywords": [
    "storybook",
    "skill",
    "ai",
    "llm",
    "documentation",
    "agent",
    "cli"
  ],
  "author": "Sergio Carracedo <hi@sergiocarracedo.es",
  "repository": "https://github.com/sergiocarracedo/storybook-to-skill-md",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/google": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@mdx-js/mdx": "^3.0.0",
    "@storybook/csf-tools": "^8.0.0",
    "ai": "^4.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "cosmiconfig": "^9.0.0",
    "p-limit": "^6.0.0",
    "playwright": "^1.58.2",
    "react-docgen-typescript": "^2.2.0",
    "remark-parse": "^11.0.0",
    "tsx": "^4.0.0",
    "unified": "^11.0.0",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/unist": "^3.0.3",
    "oxfmt": "^0.3.0",
    "oxlint": "^0.16.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  }
}
